{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=projectservice;Username=postgres;Password=postgres"
  },
  "KafkaOutbox": {
    "BootstrapServers": "localhost:9092",
    "DefaultTopic": "project-service.events",
    "DlqTopic": "project-service.dlq",
    "PollIntervalMs": 5000,
    "BatchSize": 10,
    "MaxAttempts": 5,
    "BaseDelayMs": 1000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}

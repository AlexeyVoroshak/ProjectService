{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=projectservice;Username=postgres;Password=postgres",
    "RedisConnection": "localhost:6379,allowAdmin=true"
  },
  "Redis": {
    "DatabaseIndex": 0
  },
  "KafkaOutbox": {
    "BootstrapServers": "localhost:29092",
    "DefaultTopic": "project-service.events",
    "DlqTopic": "project-service.dlq",
    "PollIntervalMs": 5000,
    "BatchSize": 10,
    "MaxAttempts": 5,
    "BaseDelayMs": 1000
  },
  "DockerKafka": {
    "Enabled": true,
    "ComposeFilePath": "docker-compose.yml",
    "StartupTimeoutMs": 60000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
